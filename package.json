{
  "name": "nexuschat-open",
  "productName": "NexusChat Open",
  "version": "1.0.0",
  "description": "Open-source, local-first AI chat: bring your own provider key — your chats and bots run on your machine.",
  "main": "src/main/main.js",
  "author": "NexusChat Open contributors",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "start:linux": "bash scripts/run-linux.sh run",
    "smoke": "bash scripts/run-linux.sh smoke",
    "ui:check": "bash scripts/run-linux.sh ui",
    "test": "node --test tests/*.test.js",
    "icon": "node scripts/gen-icon.js",
    "build:portable": "electron-builder --win portable --x64",
    "build:installer": "electron-builder --win nsis --x64",
    "dist:win": "electron-builder --win nsis portable --x64"
  },
  "devDependencies": {
    "electron": "44.1.0",
    "electron-builder": "26.15.3"
  },
  "build": {
    "appId": "app.nexuschat.open",
    "productName": "NexusChat Open",
    "files": [
      "src/**/*"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "build/icon.png"
    },
    "portable": {
      "artifactName": "NexusChat-Open-Portable-${version}.${ext}"
    },
    "nsis": {
      "oneClick": true,
      "artifactName": "NexusChat-Open-Setup-${version}.${ext}"
    },
    "toolsets": {
      "wine": "1.0.1"
    },
    "compression": "normal"
  }
}
